# Copia este archivo a .env  (cp .env.example .env). El .env real no se sube al repositorio.
PORT=3000
# Secreto para firmar/verificar JWT. En producción usa un valor largo y aleatorio.
JWT_SECRET=cambia-este-secreto-en-tu-entorno
# Endpoint del servicio SOAP del Mercado de Belén (mock del docente o el mock local)
MERCADO_SOAP_URL=http://localhost:4000/mercado
MERCADO_TIMEOUT_MS=3000
# Zona horaria para decidir qué es "el mismo día" al alimentar animales
APP_TIMEZONE=America/Guayaquil
