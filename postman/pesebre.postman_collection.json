                  "pm.test(\"id coincide\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"recursoId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
