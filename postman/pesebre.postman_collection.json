{
  "info": {
    "name": "Pesebre - Escenario C",
    "description": "Reiniciar la API (y tener el mock SOAP arriba) antes de correr la colección completa. El orden importa: cada carpeta usa variables creadas por sus primeras peticiones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Recursos",
      "item": [
        {
          "name": "01 Crear recurso (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"nombrePaja\", \"Paja del establo \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"recursoId\", r.id);",
                  "pm.test(\"estado calculado DISPONIBLE\", () => pm.expect(r.estado).to.eql(\"DISPONIBLE\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEncargado}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recursos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombrePaja}}\",\n  \"categoria\": \"PAJA\",\n  \"cantidad\": 10,\n  \"stockMinimo\": 5\n}"
            }
          }
        },
        {
          "name": "02 Ver detalle (200)",
